--FILE--
<?php

var_dump(is_int(SODIUM_CRYPTO_SECRETSTREAM_XCHACHA20POLY1305_MESSAGEBYTES_MAX));
var_dump(SODIUM_CRYPTO_SECRETSTREAM_XCHACHA20POLY1305_MESSAGEBYTES_MAX > 0);
--EXPECT--
bool(true)
bool(true)
